# Seleciona o adaptador de LLM: "fake" (offline, padrao, usado nos testes) ou "openrouter" (real).
LLM=fake

# Necessario apenas quando LLM=openrouter. Obtenha em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo usado para o chat principal (quando LLM=openrouter).
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Modelo usado pelo guardian (classificador de entrada), pode ser mais barato/rapido.
OPENROUTER_GUARDIAN_MODEL=openai/gpt-4o-mini

# Timeout (ms) para chamadas ao guardian. Qualquer estouro de tempo bloqueia a entrada (fail-closed).
GUARDIAN_TIMEOUT_MS=8000

# Caminho do arquivo SQLite usado para dados de RH e trilha de auditoria.
DB_PATH=./data/hr-shield.sqlite
