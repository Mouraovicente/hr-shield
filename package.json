{
  "name": "hr-shield",
  "version": "0.1.0",
  "description": "Chatbot de RH com defesa em camadas contra prompt injection: RBAC no código, guardrails fail-closed, filtro anti-PII e auditoria completa.",
  "type": "module",
  "license": "MIT",
  "author": "Vicente Moura",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "chat": "tsx src/cli.ts",
    "audit:report": "tsx scripts/audit-report.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
